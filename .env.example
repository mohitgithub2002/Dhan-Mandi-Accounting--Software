# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mandi_khata
# Separate database used by the integration tests (it is wiped)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mandi_khata_test
# Long random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# First malik (admin) login created by `npm run db:seed`
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_PASSWORD=admin123
# Optional: Chromium path for server-side PDF (/api/pdf)
CHROMIUM_PATH=
# Folder where backup dumps are written
BACKUP_DIR=./backups
